# Kopieren nach backend/.env und ausfüllen. Die .env wird NICHT committet.

# "ollama" (lokal) oder "gemini"
LLM_PROVIDER=gemini

# Aus https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=dein-key-hier
GEMINI_MODEL=gemini-2.5-flash

# Lokales Modell, falls LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
